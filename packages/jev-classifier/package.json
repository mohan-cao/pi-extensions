{
  "name": "@mohan-cao/jev-classifier",
  "version": "0.1.0",
  "description": "Harness-agnostic System One (Jev) classifier: request classification, response-shaping policies, and post-generation verification.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohan-cao/pi-extensions.git",
    "directory": "packages/jev-classifier"
  },
  "keywords": [
    "jev",
    "typesafe-ai",
    "system-one",
    "classifier",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "build:unchecked": "tsc -p tsconfig.json --noCheck",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
