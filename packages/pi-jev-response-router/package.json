{
  "name": "@mohan-cao/pi-jev-response-router",
  "version": "0.5.0",
  "description": "Pi extension that uses TypeSafe Jev to route each request into bounded verification, decomposition, or normal response policy.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohan-cao/pi-extensions.git",
    "directory": "packages/pi-jev-response-router"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jev",
    "typesafe-ai",
    "classifier",
    "response-router"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@mohan-cao/jev-classifier": "workspace:^",
    "@mohan-cao/jev-classify": "workspace:^",
    "@mohan-cao/jev-phase": "workspace:^",
    "@mohan-cao/jev-trajectory": "workspace:^",
    "@mohan-cao/jev-verify": "workspace:^"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "build:unchecked": "tsc -p tsconfig.json --noCheck",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
