{
  "name": "pi-jev-response-router-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "build:unchecked": "pnpm -r build:unchecked",
    "test": "pnpm -r test",
    "pack:router": "node ./scripts/pack-router.mjs",
    "publish:router": "pnpm --filter @mohan-cao/pi-jev-response-router publish --access public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@mohan-cao/jev-classifier": "workspace:^",
    "typescript": "5.8.3",
    "@types/node": "^22.0.0"
  }
}
